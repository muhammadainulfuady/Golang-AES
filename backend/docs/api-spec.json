{
  "openapi": "3.0.3",
  "info": {
    "title": "AES-256-GCM Cryptography Service API",
    "description": "Dokumentasi REST API untuk layanan enkripsi dan dekripsi teks berbasis AES-256-GCM pada backend Golang.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/crypto/generate-key": {
      "post": {
        "summary": "Generate Secret Key Baru",
        "description": "Menghasilkan kunci acak baru AES-256 (32 bytes / 256 bits) dalam format hexadecimal 64 karakter.",
        "responses": {
          "200": {
            "description": "Kunci berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateKeyResponse"
                },
                "example": {
                  "code": 200,
                  "status": "OK",
                  "pesan": "Secret Key AES-256 berhasil dibuat",
                  "data": [
                    {
                      "key": "4f9d2a1b7e8c3f5a0d1e2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e",
                      "length_bytes": 32,
                      "bit_length": 256
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Gagal menghasilkan kunci acak internal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                },
                "example": {
                  "code": 500,
                  "status": "error",
                  "pesan": "Gagal menghasilkan kunci acak internal",
                  "data": []
                }
              }
            }
          }
        }
      }
    },
    "/api/crypto/encrypt": {
      "post": {
        "summary": "Enkripsi Pesan Teks",
        "description": "Mengenkripsi plaintext menjadi ciphertext format Base64 menggunakan algoritma AES-256-GCM.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EncryptRequest"
              },
              "example": {
                "plaintext": "Pesan rahasia tugas kriptografi semester 5",
                "key": "4f9d2a1b7e8c3f5a0d1e2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pesan berhasil dienkripsi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EncryptResponse"
                },
                "example": {
                  "code": 200,
                  "status": "OK",
                  "pesan": "Pesan berhasil dienkripsi",
                  "data": [
                    {
                      "ciphertext": "yW4b123V98bN1XyZ4QkLt9mP4w8a==",
                      "algorithm": "AES-256-GCM"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Input tidak valid (panjang kunci salah atau teks kosong)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                },
                "example": {
                  "code": 400,
                  "status": "error",
                  "pesan": "Kunci harus berupa 64 karakter hexadecimal (256-bit)",
                  "data": []
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan saat enkripsi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                },
                "example": {
                  "code": 500,
                  "status": "error",
                  "pesan": "Terjadi kesalahan internal saat proses enkripsi",
                  "data": []
                }
              }
            }
          }
        }
      }
    },
    "/api/crypto/decrypt": {
      "post": {
        "summary": "Dekripsi Pesan Teks",
        "description": "Mendekripsi ciphertext Base64 kembali ke teks asli dan memverifikasi integritas payload.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecryptRequest"
              },
              "example": {
                "ciphertext": "yW4b123V98bN1XyZ4QkLt9mP4w8a==",
                "key": "4f9d2a1b7e8c3f5a0d1e2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pesan berhasil didekripsi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecryptResponse"
                },
                "example": {
                  "code": 200,
                  "status": "OK",
                  "pesan": "Pesan berhasil didekripsi",
                  "data": [
                    {
                      "plaintext": "Pesan rahasia tugas kriptografi semester 5"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Kunci salah, ciphertext rusak, atau format tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                },
                "example": {
                  "code": 400,
                  "status": "error",
                  "pesan": "Gagal mendekripsi: Kunci salah atau ciphertext telah dimanipulasi",
                  "data": []
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan saat dekripsi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                },
                "example": {
                  "code": 500,
                  "status": "error",
                  "pesan": "Terjadi kesalahan internal saat proses dekripsi",
                  "data": []
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BaseResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "status": {
            "type": "string",
            "example": "OK"
          },
          "pesan": {
            "type": "string",
            "example": "Operasi berhasil"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "example": []
          }
        }
      },
      "EncryptRequest": {
        "type": "object",
        "required": ["plaintext", "key"],
        "properties": {
          "plaintext": {
            "type": "string",
            "description": "Teks pesan yang ingin dienkripsi",
            "example": "Pesan rahasia tugas kriptografi semester 5"
          },
          "key": {
            "type": "string",
            "description": "Kunci hexadecimal tepat 64 karakter (32 bytes = 256 bits)",
            "example": "4f9d2a1b7e8c3f5a0d1e2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e"
          }
        }
      },
      "DecryptRequest": {
        "type": "object",
        "required": ["ciphertext", "key"],
        "properties": {
          "ciphertext": {
            "type": "string",
            "description": "Hasil enkripsi dalam format string Base64",
            "example": "yW4b123V98bN1XyZ4QkLt9mP4w8a=="
          },
          "key": {
            "type": "string",
            "description": "Kunci hexadecimal tepat 64 karakter (32 bytes = 256 bits)",
            "example": "4f9d2a1b7e8c3f5a0d1e2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e"
          }
        }
      },
      "GenerateKeyResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "status": { "type": "string", "example": "OK" },
          "pesan": { "type": "string", "example": "Secret Key AES-256 berhasil dibuat" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "length_bytes": { "type": "integer" },
                "bit_length": { "type": "integer" }
              }
            }
          }
        }
      },
      "EncryptResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "status": { "type": "string", "example": "OK" },
          "pesan": { "type": "string", "example": "Pesan berhasil dienkripsi" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ciphertext": { "type": "string" },
                "algorithm": { "type": "string" }
              }
            }
          }
        }
      },
      "DecryptResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "status": { "type": "string", "example": "OK" },
          "pesan": { "type": "string", "example": "Pesan berhasil didekripsi" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "plaintext": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
